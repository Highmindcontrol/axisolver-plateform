# ─────────────────────────────────────────────────────────────
# AxiSolver — variables d'environnement de développement
# Copier ce fichier en `.env.local` puis remplir les valeurs.
# ─────────────────────────────────────────────────────────────

# ─── Supabase (DB + Auth) ───
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Connexion directe Postgres pour Drizzle (migrations + queries serveur
# si besoin). Récupérer dans Supabase Dashboard → Settings → Database →
# Connection string (session mode pour les migrations).
DATABASE_URL=

# ─── URL publique du site (pour redirections OAuth, callbacks, etc.) ───
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ─── IA — moteurs bruts (doctrine : jamais de SaaS tiers pour l'intelligence) ───
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ─── Vocal (Azure TTS / Speech) ───
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=

# ─── Brevo (emails transactionnels — rapport quotidien, notifications) ───
BREVO_API_KEY=
CONTACT_FROM_EMAIL=contact@axisolver.app
CONTACT_FROM_NAME=AxiSolver
